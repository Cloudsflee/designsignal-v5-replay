{
  "name": "designsignal-v5-replay",
  "version": "5.0.0",
  "description": "Auditable daily design intelligence and ZJU 337/902 study signal system",
  "type": "module",
  "private": false,
  "bin": {
    "designsignal": "./bin/designsignal.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "test:syntax": "node --check ./bin/designsignal.mjs",
    "verify": "npm run test:syntax && npm test && npm run doctor && npm run collect:fixture",
    "doctor": "node ./bin/designsignal.mjs doctor",
    "collect:fixture": "node ./bin/designsignal.mjs collect --fixture --dry-run",
    "daily:fixture": "node ./bin/designsignal.mjs daily --fixture --dry-run",
    "daily:live": "node ./bin/designsignal.mjs daily",
    "start": "node ./bin/designsignal.mjs serve"
  },
  "license": "MIT"
}
