# Runtime
DESIGNSIGNAL_DATA_DIR=./data
DESIGNSIGNAL_HOST=127.0.0.1
DESIGNSIGNAL_PORT=3379
DESIGNSIGNAL_TIMEOUT_MS=12000
DESIGNSIGNAL_RETRIES=2
DESIGNSIGNAL_MAX_BYTES=2000000
DESIGNSIGNAL_LIVE_DEADLINE_MS=1200000
DESIGNSIGNAL_REQUIRED_CHANNEL=feishu

# Optional custom sources. Add every custom public host to the allowlist.
# DESIGNSIGNAL_SOURCES_FILE=./config/sources.example.json
DESIGNSIGNAL_ALLOWED_HOSTS=api.openalex.org,export.arxiv.org,arxiv.org,www.idi.zju.edu.cn,www.tsinghua.edu.cn,dl.acm.org,www.core77.com,s3files.core77.com,www.dezeen.com,static.dezeen.com,www.designboom.com,www.yankodesign.com,www.awwwards.com,assets.awwwards.com,www.producthunt.com,ph-files.imgix.net,openai.com,deepmind.google,www.microsoft.com,huggingface.co,www.media.mit.edu

# Optional OpenAI-compatible Responses API. Keep values in the environment.
DESIGNSIGNAL_MODEL=
DESIGNSIGNAL_OPENAI_BASE_URL=https://api.openai.com/v1
DESIGNSIGNAL_OPENAI_API_KEY=
# Or point to an explicit Codex config; the file is read in memory only.
DESIGNSIGNAL_CODEX_CONFIG=

# Durable push outbox. Live verification uses only feishu. Fixture verification
# covers generic,feishu,wecom,feishu-document without sending real messages.
# Endpoints and credentials are never copied into outbox files.
DESIGNSIGNAL_PUSH_CHANNELS=feishu
DESIGNSIGNAL_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOC_FOLDER_TOKEN=
FEISHU_TENANT_BASE_URL=https://feishu.cn
